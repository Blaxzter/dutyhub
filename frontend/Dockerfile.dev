FROM node:26-alpine

WORKDIR /app

COPY package.json pnpm-lock.yaml ./

# Derive the pnpm version from package.json's `packageManager` rather than
# hardcoding it, so it cannot drift when that pin is bumped.
RUN npm install -g \
    "pnpm@$(node -p "require('./package.json').packageManager.replace(/^pnpm@/, '').split('+')[0]")" \
    && pnpm install

COPY . .

EXPOSE 5555

CMD ["pnpm", "dev", "--host"]
