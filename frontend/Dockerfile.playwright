FROM mcr.microsoft.com/playwright:v1.62.1-jammy

WORKDIR /app

# Copy package.json and pnpm-lock.yaml
COPY package.json pnpm-lock.yaml ./

# Install the pnpm version pinned in package.json's `packageManager`, so the
# image resolves the lockfile with the same major that generated it.
RUN npm install -g \
    "pnpm@$(node -p "require('./package.json').packageManager.replace(/^pnpm@/, '').split('+')[0]")"

# Install dependencies
RUN pnpm install

# Copy the rest of the application
COPY . .

# Build the frontend for preview mode
ARG VITE_API_URL
ARG VITE_E2E_AUTH_BYPASS=true
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_E2E_AUTH_BYPASS=${VITE_E2E_AUTH_BYPASS}
RUN pnpm build

# Set default command to run tests
CMD ["npx", "playwright", "test"]
