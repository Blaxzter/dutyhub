# This is just when you prefer to start the frontend with `pnpm dev` instead of `docker-compose up`. If using Docker, the frontend will use the backend's internal Docker network address to connect, so this doesn't need to be set.
VITE_API_URL=http://localhost:8787/api/v1

# Playwright E2E: renders the app as signed in without a real login. Needs all
# three of these to line up — this flag at build time, an `e2e_bypass=1` cookie
# on the run, and a backend started with TESTING=true, which is what actually
# resolves the identity from the X-Test-User-Email header.
VITE_E2E_AUTH_BYPASS=false
